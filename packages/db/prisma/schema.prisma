// Minimal Prisma schema for the template. SQLite so a fresh clone runs with no
// database server. Real SSA Pro uses Postgres with many models; here there is
// ONE example model (SampleItem) that the Sample Tracker module reads and
// writes. Add your module's models below and run ./scripts/reset.sh.
//
// Note: SQLite does not support Prisma enums or scalar lists. Use String
// columns (as SampleItem.category does) instead of enum types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The example module's data. `projectSlug` scopes each row to a project (the
// same slug the shell uses in PortfolioProject). Kept as a plain String rather
// than a foreign key because the template serves its project list statically
// from @ssa/project-context; PHASE-3 would make projects a real table.
model SampleItem {
  id          String   @id @default(cuid())
  projectSlug String
  title       String
  category    String
  owner       String
  createdAt   DateTime @default(now())

  @@index([projectSlug])
}

// A saved business case. The module is local-first: the working case lives in the
// browser and is written here only when the user explicitly saves, so a case in
// progress never leaves the machine.
//
// `payload` holds the whole case.workforce.v2 document as JSON text rather than a
// column per assumption. The case is a single versioned document that the engine
// validates on read, and its shape changes as the model grows — normalising it
// would mean a migration every time a driver is added, with no query benefit
// because nothing ever filters on an individual assumption.
//
// Stored as String, not Json: the template's guidance is to stay on SQLite's
// lowest common denominator so a model carries over to Postgres unchanged.
model BusinessCase {
  id          String   @id @default(cuid())
  projectSlug String
  name        String
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Saving under an existing name updates that case rather than accumulating
  // near-duplicates the user cannot tell apart.
  @@unique([projectSlug, name])
  @@index([projectSlug])
}
